# Copy this file to ".env" and fill in your own key. NEVER commit ".env".
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model (default: gemini-flash-latest).
# Pin a specific model name here if you want predictable behaviour.
# GEMINI_MODEL=gemini-flash-latest

# Optional: set to 1 to always run in Demo/Fallback mode (no API calls).
# HUSTLEPILOT_DEMO_MODE=0
